# Google OAuth is required before customer ledger data can be created in Sheets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Use a strong, unique value outside local development.
ADMIN_KEY=local-admin

# Required only when Razorpay webhooks are enabled.
RAZORPAY_WEBHOOK_SECRET=

# Copy to `.env` for local runs. Leave Google vars empty to use the local-dev workspace.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# AES-256 key used to encrypt Google refresh tokens at rest.
# In production this must be 64 hex characters (32 bytes).
TOKEN_ENCRYPTION_KEY=

ADMIN_KEY=local-admin
RAZORPAY_WEBHOOK_SECRET=
PORT=3000
